(declare-const X_0 Real)
(declare-const X_1 Real)
(declare-const X_2 Real)
(declare-const X_3 Real)
(declare-const Y_0 Real)
(declare-const Y_1 Real)

; Input constraints
(assert (>= X_0 -0.1))
(assert (<= X_0 0.1))
(assert (>= X_1 -0.1))
(assert (<= X_1 0.1))
(assert (>= X_2 -0.1))
(assert (<= X_2 0.1))
(assert (>= X_3 -0.1))
(assert (<= X_3 0.1))

; Output constraint (target class 1 is largest)
(assert (>= Y_1 Y_0))
